APP_NAME="Fees Management System"
APP_ENV=development
APP_DEBUG=0
APP_URL=http://localhost/fees
APP_TIMEZONE=Asia/Kolkata

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fees_management_test
DB_USERNAME=root
DB_PASSWORD=

# Generate an independent random value of at least 32 characters for OTP_HASH_KEY.
# Mobile sign-in stays unavailable until this key and Mailpit settings are configured.
OTP_HASH_KEY=

# The active local Mailpit process was inspected at 127.0.0.1:1025.
MAIL_PROVIDER=mailpit
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=none
MAIL_FROM_ADDRESS=feesportal@feesportal.test
MAIL_FROM_NAME="FeesPortal Development"
MAIL_TIMEOUT=5

# Webhooks are optional for checkout; pending payments are verified from the server when status is checked.
# If using webhook notifications, register https://your-domain/fees/integrations/payment-gateway/webhook.php
# in Razorpay and subscribe to payment.captured and payment.failed.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional when webhook notifications are enabled.
RAZORPAY_WEBHOOK_SECRET=
